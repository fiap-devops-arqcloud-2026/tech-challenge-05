# =================================================================
# Exemplo de .env para o ambiente LOCAL (Docker Compose)
# =================================================================
# Copie para .env (ignorado pelo Git) só se quiser trocar algum valor.
# Sem .env, o docker-compose.yaml usa exatamente estes padrões.
# Tudo aqui é fictício e só vale na sua máquina: NUNCA coloque neste
# arquivo chave real de AWS, APM, PagerDuty ou Slack.
# =================================================================

# PostgreSQL local (um servidor com ngo_db e donation_db)
POSTGRES_USER=solidary
POSTGRES_PASSWORD=solidary-local
POSTGRES_PORT=5432

# Região usada pelos SDKs ao falar com o emulador (o projeto usa us-east-2 na AWS)
AWS_REGION=us-east-2

# Portas publicadas na máquina
NGO_PORT=8081
DONATION_PORT=8082
VOLUNTEER_PORT=8083
MOTO_PORT=5000
OTLP_HTTP_PORT=4318
