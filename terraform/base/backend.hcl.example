# =================================================================
# RAIZ BASE — exemplo de backend.hcl
# =================================================================
# Copie para backend.hcl, que o Git ignora, e troque o sentinela pelo
# nome real do bucket de estado (output state_bucket_name da raiz
# bootstrap, no formato <projeto>-tfstate-<conta>-<região>-an):
#   cp backend.hcl.example backend.hcl
#
# A chave (phase5/prod/base.tfstate), a criptografia e o lock ficam fixos
# em versions.tf; aqui entram só o bucket e a região.
# Com o sentinela no lugar, o init falha de propósito: o nome tem
# maiúsculas, que a S3 não aceita em bucket.
# =================================================================

bucket = "SUBSTITUIR_PELO_STATE_BUCKET_NAME"
region = "us-east-2"
