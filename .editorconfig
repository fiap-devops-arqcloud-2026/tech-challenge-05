# EditorConfig: o editor de cada integrante segue o mesmo padrão de
# codificação, fim de linha e indentação (https://editorconfig.org).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python: PEP 8 pede 4 espaços.
[*.py]
indent_size = 4

# Go: o gofmt usa tabulação; não brigar com ele.
[{*.go,go.mod,go.sum}]
indent_style = tab
indent_size = 4

# Markdown usa dois espaços no fim da linha como quebra; não apagar.
[*.md]
trim_trailing_whitespace = false

# Makefile exige tabulação.
[Makefile]
indent_style = tab
